# EstágioHub — variáveis de ambiente.
# Rode `make env`: copia este arquivo para .env e gera os segredos vazios.
# Nunca versione o .env. Valores vazios usam o padrão do docker-compose.yml.

# --- Segredos (gerados por `make env`) ---
JWT_SECRET=
POSTGRES_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# --- IA (preenchido pela equipe; vazio = agentes em "modo regras") ---
ANTHROPIC_API_KEY=
LLM_MODEL=

# --- Opcionais (vazio = padrão) ---
LOG_LEVEL=
JWT_EXPIRES_MINUTES=
REC_WEIGHT_CONTENT=
REC_WEIGHT_ATTRIBUTES=
REC_WEIGHT_PREFERENCE=
FOLLOWUP_INTERVAL_MINUTES=
